# Contraseña para acceder a la aplicación
APP_PASSWORD=cambiar-esto

# Secreto para firmar cookies de sesión (generar una cadena larga y aleatoria)
SESSION_SECRET=cambiar-por-una-cadena-secreta-muy-larga-y-segura-1234567890

# Zona horaria (Caracas para el horario de sesiones)
TZ=America/Caracas

# Puerto del servidor
PORT=3000

# Horario semanal: dia(1=lun..7=dom)|inicio|fin ; separados por coma
# 1 = Lunes 15:00 a 16:30
# 3 = Miércoles 15:00 a 16:30
# 5 = Viernes 10:45 a 12:15
SCHEDULE=1|15:00|16:30,3|15:00|16:30,5|10:45|12:15

# Desde qué fecha se generan sesiones (YYYY-MM-DD). Si está vacío: fecha del primer arranque.
START_DATE=

# Directorio de almacenamiento de datos y fotos (en Docker es /data)
DATA_DIR=./data
